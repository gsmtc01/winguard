{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "WinGuard default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "ms-settings:*" },
        { "url": "windowsdefender:*" },
        { "url": "https://www.virustotal.com/*" },
        { "url": "https://ai.google.dev/*" },
        { "url": "https://github.com/*" },
        { "url": "https://objects.githubusercontent.com/*" }
      ]
    }
  ]
}
